# Base locale de développement (docker compose). Le port hôte est 5433 pour
# ne pas entrer en conflit avec un autre PostgreSQL déjà en écoute.
DATABASE_URL=postgres://klaar:klaar_dev_only@localhost:5433/klaar

# Story 0.12 — Web Push (ADR-010). Générer un couple avec :
#   cargo run -p klaar-api --bin klaar-vapid
# La clé publique est distribuée aux navigateurs ; la privée ne sort jamais du
# serveur. En changer invalide TOUS les abonnements existants.
KLAAR_VAPID_PRIVATE_KEY=
KLAAR_VAPID_SUBJECT=mailto:ops@klaar.be
