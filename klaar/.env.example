# Base locale de développement (docker compose). Le port hôte est 5433 pour
# ne pas entrer en conflit avec un autre PostgreSQL déjà en écoute.
DATABASE_URL=postgres://klaar:klaar_dev_only@localhost:5433/klaar

# Story 0.12 — Web Push (ADR-010). Générer un couple avec :
#   cargo run -p klaar-api --bin klaar-vapid
# La clé publique est distribuée aux navigateurs ; la privée ne sort jamais du
# serveur. En changer invalide TOUS les abonnements existants.
KLAAR_VAPID_PRIVATE_KEY=
KLAAR_VAPID_SUBJECT=mailto:ops@klaar.be

# Story 1.1 — inscription.
# Racine publique de la PWA : sert à composer le lien de vérification envoyé
# par courriel. Sans elle, le lien pointe le serveur de développement.
KLAAR_URL_PUBLIQUE=http://localhost:4321

# Journalise le lien de vérification complet. **Développement uniquement** :
# le jeton apparaîtrait alors dans les journaux, où il se lit sans
# authentification et survit à sa validité.
KLAAR_COURRIEL_AFFICHER_LIEN=0

# Croire `X-Forwarded-For` pour la limitation de débit. À poser à 1 seulement
# derrière un proxy de confiance : sinon, changer un en-tête suffit à
# contourner la limite.
KLAAR_DERRIERE_PROXY=0

# Story 1.3 — sessions (FR-004).
# Secret de signature du jeton d'accès, 32 octets minimum. Sans lui, klaar-api
# refuse de démarrer : en générer un à la volée invaliderait toutes les sessions
# à chaque redémarrage. En générer un : openssl rand -base64 48
KLAAR_JWT_SECRET=

# Poser l'attribut `Secure` sur le cookie de rafraîchissement. Vrai par défaut ;
# à mettre à 0 uniquement en développement local sur HTTP, où le navigateur
# refuserait sinon le cookie sans rien signaler.
KLAAR_COOKIE_SECURE=1

# Story 1.9 — effacement RGPD.
# Aucune variable : le délai de trente jours est fixé par FR-005, et l'exécution
# passe par le binaire `klaar-effacer`, à planifier. Exemple de tâche cron
# quotidienne :
#   0 3 * * * DATABASE_URL=... /chemin/vers/klaar-effacer

# Story 2.2 — catalogue.
# Retire le catalogue le temps d'une mise à jour : l'API répond alors 503 avec
# `Retry-After: 60`, ce qui distingue un retrait volontaire d'une panne.
KLAAR_CATALOGUE_MAINTENANCE=0

# Story 3.1 — Demandes.
# FR-011 fait de la méthode de paiement une précondition. Le contrôle est actif
# par défaut : l'oublier allumé ne coûte qu'un refus explicite, l'oublier éteint
# laisse passer des Demandes qu'aucun paiement ne garantit. À 0 uniquement là où
# Stripe n'est pas provisionné (Story 1.7).
KLAAR_EXIGER_METHODE_PAIEMENT=1

# Story 1.6 (partielle) — prestataires de démonstration.
# Le binaire `klaar-prestataires-demo` active des prestataires SANS contrôle BCE
# et refuse de tourner sans ce drapeau. Leur origine est marquée DEMONSTRATION
# en base, de sorte qu'ils restent identifiables longtemps après.
KLAAR_PRESTATAIRES_DEMO=0

# --- Déploiement (compose.deploiement.yml) ---------------------------------
#
# Ces variables ne servent qu'au déploiement conteneurisé, pas au
# développement local. Les recopier dans un `.env.deploiement`, absent du
# dépôt : un fichier de composition qui porte ses secrets finit poussé par
# mégarde.

# Mot de passe de la base **de déploiement**. Sans valeur, la composition
# refuse de démarrer — c'est voulu : un défaut silencieux ferait tourner la
# production avec le mot de passe de développement.
KLAAR_PG_PASSWORD=

# Port publié sur la boucle locale de l'hôte. Le proxy inverse termine TLS
# devant ; publier sur 0.0.0.0 servirait l'API en clair.
KLAAR_PORT=8080

# Adresse d'écoute du site. `127.0.0.1` par défaut : la place normale du
# service est derrière un proxy inverse qui termine TLS. `0.0.0.0` l'ouvre sur
# toutes les interfaces — le service est alors servi **en clair**, et les mots
# de passe, codes de seconde authentification et jetons de session transitent
# sans chiffrement. À ne poser que pour une vitrine, en le sachant.
KLAAR_BIND=127.0.0.1

# --- Terminaison TLS (compose.tls.yml) -------------------------------------
#
# Le nom d'hôte doit résoudre vers cette machine **avant** le premier
# démarrage : Caddy demande un certificat à Let's Encrypt, qui valide le
# domaine en interrogeant le port 80. Un nom qui ne résout pas encore fait
# échouer la demande, et Let's Encrypt limite à cinq essais par semaine et par
# domaine.
#
# **Un seul nom suffit.** Le front appelle `/api/v1` en relatif : donner à
# l'API son propre sous-domaine imposerait du CORS et un `SameSite=None` sur le
# cookie de rafraîchissement — deux garanties relâchées pour rien.
KLAAR_DOMAINE=
# Let's Encrypt prévient à cette adresse avant l'expiration d'un certificat
# qu'il n'aurait pas pu renouveler.
KLAAR_ACME_EMAIL=

# --- Envoi de courriel par webhook (Story 1.2, FR-001) ---------------------
#
# **Sans cette URL, les courriels sont composés et journalisés, jamais
# expédiés.** Le défaut ne doit pas être « essayer d'envoyer quelque part » :
# une variable mal recopiée enverrait les courriels d'inscription — jeton de
# vérification compris — à l'adresse qui s'y trouve.
#
# La composition reste dans le service : sujet, corps traduit et lien de
# vérification. Le webhook ne reçoit qu'un message déjà écrit et le remet à un
# relais. Déporter la composition dans le flux mettrait les traductions hors du
# dépôt, hors des tests et hors de portée d'une relecture.
KLAAR_COURRIEL_WEBHOOK_URL=
# Jeton porteur, si le webhook en attend un. Un webhook sans authentification
# est une route publique qui envoie des courriels en votre nom.
KLAAR_COURRIEL_WEBHOOK_JETON=
# Racine publique, pour construire le lien de vérification.
KLAAR_URL_PUBLIQUE=

# --- Mentions légales du site (build de la PWA) ----------------------------
#
# Lues par Astro **à la construction** du site, pas au démarrage du serveur :
# les recompiler demande de rebâtir l'image du site. Préfixe `PUBLIC_` imposé
# par Astro pour toute variable qui atteint le navigateur.
#
# **Elles sont vides par défaut, et la page le dit.** Un défaut plausible —
# un nom d'éditeur, un numéro d'entreprise d'exemple — serait pris pour une
# identité réelle : un numéro BCE dont la clé de contrôle tombe juste désigne
# une personne morale existante. Non renseignées, la page affiche ce qui reste
# à faire, ce qui est exact.
#
# Un service ouvert au public doit les poser : l'identification de l'éditeur
# est une obligation.
PUBLIC_KLAAR_DOMAINE=
PUBLIC_KLAAR_LEGAL_EDITEUR=
PUBLIC_KLAAR_LEGAL_STATUT=
PUBLIC_KLAAR_LEGAL_VILLE=
PUBLIC_KLAAR_LEGAL_BCE=
PUBLIC_KLAAR_LEGAL_CONTACT=
# Dépôt du code source, cité au titre de la licence MIT.
PUBLIC_KLAAR_DEPOT=gilmry/klaar
