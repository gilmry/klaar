/target
.schemathesis/
node_modules/
packages/klaar-client/openapi.json
packages/klaar-client/src/schema.d.ts
*.cdx.json
# Rapports d'audit de la trace (Story 3.8) : ils portent des agrégats
# géographiques et n'ont pas à voyager dans le dépôt.
audit-biais-*.json
*.sig
*.pem

# Story 0.2 — PWA
web/node_modules/
web/dist/
web/.astro/
web/test-results/
web/playwright-report/
# Parcours filmés (Story 4.11) : vidéos et rapports sont des artefacts de CI,
# publiés sur GitHub Pages. Des mégaoctets de binaire dans l'historique git
# n'apporteraient rien et ne se relisent pas.
web/playwright-report-demo/
web/demo-resultats/
web/demo-resultats.json
web/vitrine/

# Secrets locaux (clé privée VAPID, DATABASE_URL) — jamais committés.
.env

# Story 0.7 — état local du déploiement continu (`deploy.sh`). Ces fichiers
# décrivent *cette* machine : la révision qu'elle fait tourner, son verrou de
# concurrence, son journal. Les versionner ferait qu'une machine écrase l'état
# d'une autre au prochain `git pull`.
/.env.deploiement
/.deployed_rev
/.deploy.lock
/deploy.log
