# Image de service pour klaar-api (Story 0.7, préalable au déploiement).
#
# **Sans elle, l'application n'est déployable nulle part.** Ce n'était pas un
# manque d'hébergeur : le service tournait en processus natif sur un poste de
# développement, et rien ne permettait de le construire ailleurs de façon
# reproductible. Le manque a été pris pour une dépendance à OVH ; il n'en était
# pas une. Avec cette image, « il faut un compte OVH » devient « il faut un
# hôte », ce qui n'est pas la même phrase.
#
# **Deux étapes, et l'exécution ne contient pas de compilateur.** Une image qui
# embarque la chaîne Rust pèse deux gigaoctets et offre à qui l'ouvre de quoi
# compiler ce qu'il veut. Ce qui part en production est le binaire et rien
# d'autre.
#
# `Containerfile` et non `Dockerfile` : le format est le même, le nom ne
# désigne pas un outil unique — podman et buildah le lisent aussi bien.

# --- étape 1 : compilation -------------------------------------------------
#
# La version est celle de `rust-version` dans Cargo.toml. Épinglée et non
# `latest` : une image de base qui bouge sous les pieds fait échouer une
# reconstruction identique, et c'est le contraire d'une image reproductible.
FROM docker.io/library/rust:1.88-bookworm AS compilation

WORKDIR /src

# Les manifestes d'abord, le code ensuite : une modification de source ne doit
# pas invalider le cache des dépendances, qui est l'essentiel du temps de
# compilation.
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY migrations ./migrations

# `--locked` : la compilation refuse de mettre à jour `Cargo.lock`. Une image
# qui résoudrait ses dépendances à la construction ne produirait pas deux fois
# le même binaire, et le SBOM publié par la CI ne décrirait plus ce qui tourne.
RUN cargo build --release --locked \
        --bin klaar-api \
        --bin klaar-migrate \
        --bin klaar-expirer \
        --bin klaar-effacer

# --- étape 2 : exécution ---------------------------------------------------
#
# `debian:bookworm-slim` et non `scratch` : les binaires sont liés à la glibc et
# à OpenSSL. Une image `scratch` demanderait une compilation statique musl, donc
# une chaîne de compilation croisée — un coût réel pour un gain qui ne se voit
# qu'à la taille de l'image.
FROM docker.io/library/debian:bookworm-slim AS service

# `ca-certificates` : sans elles, tout appel HTTPS sortant échoue avec une
# erreur de certificat que personne ne relie à l'image. `curl` sert au contrôle
# de santé et rien d'autre.
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl \
 && rm -rf /var/lib/apt/lists/*

# **Un compte non privilégié.** Un service qui tourne en root donne le root de
# l'hôte à qui trouve une évasion de conteneur, et il n'a besoin d'aucun droit
# particulier : il écoute au-dessus de 1024 et n'écrit sur aucun disque.
RUN useradd --system --create-home --uid 10001 klaar
USER klaar
WORKDIR /home/klaar

COPY --from=compilation /src/target/release/klaar-api /usr/local/bin/
COPY --from=compilation /src/target/release/klaar-migrate /usr/local/bin/
COPY --from=compilation /src/target/release/klaar-expirer /usr/local/bin/
COPY --from=compilation /src/target/release/klaar-effacer /usr/local/bin/

EXPOSE 8080

# Le contrôle de santé interroge la route que le service expose déjà, plutôt
# qu'un fichier témoin : un processus vivant qui ne répond plus est exactement
# ce qu'un redémarrage doit corriger.
HEALTHCHECK --interval=15s --timeout=3s --start-period=20s --retries=3 \
    CMD curl -fsS http://127.0.0.1:8080/api/v1/health || exit 1

# Les trois autres binaires — migrations, balayage, effacement — s'invoquent en
# surchargeant la commande. Ils ne sont pas des services : les lancer au
# démarrage du conteneur ferait tourner un balayage par exemplaire du serveur,
# ce que leur en-tête interdit explicitement.
CMD ["klaar-api"]

# --- étape 3 : construction du site ----------------------------------------
#
# **La PWA fait partie du déploiement.** Le front appelle `/api/v1` sur la
# **même origine** : sans un serveur qui l'expose et relaie l'API, le service
# déployé n'est joignable que par un client HTTP, pas par l'application. C'est
# la différence entre « l'API est déployable » et « l'application est
# déployable », et je l'avais manquée en n'empaquetant que le binaire.
FROM docker.io/library/node:22-bookworm-slim AS construction-site

WORKDIR /site
COPY web/package.json web/package-lock.json ./
# `npm ci` et non `install` : il installe exactement le verrou, et échoue si le
# verrou et le manifeste divergent. Une construction qui résoudrait ses
# dépendances ne produirait pas deux fois le même site.
RUN npm ci --no-audit --no-fund
COPY web ./

# **Les mentions légales sont figées ici.** Astro remplace les
# `import.meta.env.PUBLIC_*` par leur valeur au moment de la construction :
# elles ne peuvent pas être posées au démarrage du conteneur, et changer
# l'éditeur demande de reconstruire l'image. C'est la contrepartie d'un site
# statique, et la CI expose un déclenchement manuel pour ce seul cas.
#
# Aucune valeur par défaut, en particulier pour le numéro d'entreprise : un
# numéro dont la clé de contrôle tombe juste désigne une personne morale
# réelle, et un défaut se recopie sans être relu. Vides, la page affiche ce
# qu'il reste à renseigner, ce qui est exact.
ARG PUBLIC_KLAAR_DOMAINE
ARG PUBLIC_KLAAR_LEGAL_EDITEUR
ARG PUBLIC_KLAAR_LEGAL_STATUT
ARG PUBLIC_KLAAR_LEGAL_VILLE
ARG PUBLIC_KLAAR_LEGAL_BCE
ARG PUBLIC_KLAAR_LEGAL_CONTACT
ARG PUBLIC_KLAAR_DEPOT

ENV PUBLIC_KLAAR_DOMAINE=$PUBLIC_KLAAR_DOMAINE \
    PUBLIC_KLAAR_LEGAL_EDITEUR=$PUBLIC_KLAAR_LEGAL_EDITEUR \
    PUBLIC_KLAAR_LEGAL_STATUT=$PUBLIC_KLAAR_LEGAL_STATUT \
    PUBLIC_KLAAR_LEGAL_VILLE=$PUBLIC_KLAAR_LEGAL_VILLE \
    PUBLIC_KLAAR_LEGAL_BCE=$PUBLIC_KLAAR_LEGAL_BCE \
    PUBLIC_KLAAR_LEGAL_CONTACT=$PUBLIC_KLAAR_LEGAL_CONTACT \
    PUBLIC_KLAAR_DEPOT=$PUBLIC_KLAAR_DEPOT

RUN npm run build

# --- étape 4 : service du site ---------------------------------------------
FROM docker.io/library/nginx:1.27-alpine AS site

COPY --from=construction-site /site/dist /usr/share/nginx/html
# La carte `$connection_upgrade` doit vivre dans le contexte `http`, pas dans
# un bloc `server` : nginx refuse de démarrer si elle est au mauvais endroit.
COPY web/nginx-upgrade.conf /etc/nginx/conf.d/../conf.d/00-upgrade.conf
COPY web/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 8081

HEALTHCHECK --interval=15s --timeout=3s --start-period=5s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1:8081/ || exit 1
