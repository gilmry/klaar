import AppLayout from "../layouts/AppLayout.astro";
---

<AppLayout titre="Hors ligne — Klaar" description="Page servie quand le réseau est indisponible.">
  <h1>Pas de réseau</h1>
  <p>
    Cette page est servie par le service worker quand le réseau ne répond pas.
    Ce que vous avez saisi est conservé sur cet appareil et sera envoyé dès la
    reconnexion, une seule fois.
  </p>
  <p><a href="/">Retour à l'accueil</a></p>
</AppLayout>
