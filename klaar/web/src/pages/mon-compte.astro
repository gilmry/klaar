---
import AppLayout from "../layouts/AppLayout.astro";
import MonCompte from "../components/MonCompte.svelte";
---

<AppLayout titre="Klaar — mon compte" description="Gestion de votre compte Klaar.">
  <h1>Mon compte</h1>

  <h2>Effacer mon compte</h2>
  <p class="klaar-tempere">
    Le règlement général sur la protection des données (article 17) vous donne le
    droit d'obtenir l'effacement de vos données. Vous pouvez l'exercer ici, sans
    justification à fournir.
  </p>

  <MonCompte client:load />
</AppLayout>
