{
  "title": "Klaar API — Story 0.8",
  "uid": "klaar-api-overview",
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Requêtes / s par endpoint",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum by (endpoint, status) (rate(klaar_api_http_requests_total[1m]))",
          "legendFormat": "{{endpoint}} ({{status}})"
        }
      ]
    },
    {
      "id": 2,
      "title": "Latence p95 par endpoint",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, endpoint) (rate(klaar_api_http_requests_duration_seconds_bucket[5m])))",
          "legendFormat": "{{endpoint}} p95"
        }
      ]
    }
  ]
}
